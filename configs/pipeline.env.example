# Copy to configs/pipeline.env and edit the right-hand side only.
# Keep every path in the Linux/WSL filesystem and avoid spaces.
SURGICAI_PUBLIC_ROOT=${HOME}/suturing-policy-sim2real
SURGICAI_RESULT_ROOT=${HOME}/surgicai_runs

# Third-party source/build locations.
AMBF_ROOT=${HOME}/surgicai_external/ambf
SRC_ROOT=${HOME}/surgicai_external/surgical_robotics_challenge
FOUNDATIONPOSE_ROOT=${HOME}/surgicai_external/FoundationPose
DA_ROOT=${HOME}/surgicai_external/Depth-Anything-V2
DA_CHECKPOINT=${HOME}/surgicai_models/p5a_vitl_fp32_best.pth

# Always choose an unused non-zero domain. One complete pipeline uses this
# domain sequentially; do not run another AMBF/ROS job in the same domain.
ROS_DOMAIN_ID=220

# ROS/AMBF bridge setup files. These are sourced by the runners.
SIM_S3_ROS_SETUP=/opt/ros/humble/setup.bash
SIM_S4_ROS_SETUP=/opt/ros/humble/setup.bash
SIM_S3_AMBF_ROS_SETUP=${HOME}/ambf_ros_ws/install/setup.bash
SIM_S4_AMBF_ROS_SETUP=${HOME}/ambf_ros_ws/install/setup.bash

# Generated by scripts/prepare_ambf_launch.py after SRC_ROOT is installed.
SIM_S3_STEREO_LAUNCH=${HOME}/.cache/surgicai/launch/depth_audit_stereo.launch.yaml
SIM_S4_STEREO_LAUNCH=${HOME}/.cache/surgicai/launch/depth_audit_stereo.launch.yaml

# Released assets. The public defaults are repeated here so the active
# contract is visible in one place.
SIM_S4_MODEL=${SURGICAI_PUBLIC_ROOT}/models/rl/m3_measured_r3_100k.zip
SIM_S4_SIM_S3_ROOT=${SURGICAI_PUBLIC_ROOT}/data/reference/sim_s3_20260811
SIM_S3_FP_IMAGE=foundationpose:blackwell
SIM_S3_FP_MESH=${SRC_ROOT}/ADF/Phantoms/3D_MED/high_res/Needle_stage_d_v0.OBJ

# Formal experiment contract. scripts/run_simulation.py --profile smoke/formal
# sets episode counts; these values document the formal defaults.
SIM_S3_EVAL_SEED=1
SIM_S3_YAW_DEG=15
SIM_S3_X_MM=3
SIM_S3_Y_MM=3
SIM_S3_EPISODES=40
SIM_S4_EPISODES=30
SIM_S4_CELL_TIMEOUT_S=3600
